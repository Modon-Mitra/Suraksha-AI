<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <!--  =========================  -->
        <!--  MY TRACKING ID            -->
        <!--  =========================  -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp" app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="16dp" app:cardElevation="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛰 Your Tracking ID" android:textColor="@color/brand_blue" android:textStyle="bold" android:textSize="15sp"/>
                <TextView android:id="@+id/tv_my_tracking_id" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="SA-XXXXXXX" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="20sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Share this ID with trusted people so they can track your live location." android:textColor="@color/text_secondary" android:textSize="12sp"/>
                <Button android:id="@+id/btn_share_tracking" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="12dp" android:text="Share My ID" android:textAllCaps="false" android:backgroundTint="@color/brand_blue" android:textColor="@color/bg_dark"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <!--  =========================  -->
        <!--  MY PHONE NUMBER           -->
        <!--  =========================  -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp" app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="16dp" app:cardElevation="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📱 Your Phone Number" android:textColor="@color/brand_blue" android:textStyle="bold" android:textSize="15sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="10dp" android:text="Save your number once so trusted contacts can find you automatically by phone number." android:textColor="@color/text_secondary" android:textSize="12sp"/>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:hint="Your Phone Number (e.g. +919876543210)" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_my_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:textColor="@color/text_primary"/>
                </com.google.android.material.textfield.TextInputLayout>
                <Button android:id="@+id/btn_save_my_phone" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Save Number" android:textAllCaps="false" android:backgroundTint="@color/brand_blue" android:textColor="@color/bg_dark"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <!--  =========================  -->
        <!--  CONTACTS                  -->
        <!--  =========================  -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="👥 Emergency Contacts" android:textColor="@color/brand_blue" android:textSize="15sp" android:textStyle="bold"/>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="14dp" app:cardElevation="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:hint="Name" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:textColor="@color/text_primary"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:hint="Phone Number" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:textColor="@color/text_primary"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:hint="Tracking ID (optional)" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_tracking_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColor="@color/text_primary"/>
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:text="💡 Just enter name + phone. Tracking ID is found automatically if the other person has saved their phone number in Settings." android:textColor="@color/text_secondary" android:textSize="11sp"/>
                <Button android:id="@+id/btn_add_contact" android:layout_width="match_parent" android:layout_height="44dp" android:text="+ Add Contact" android:backgroundTint="@color/brand_blue" android:textColor="@color/bg_dark" android:textStyle="bold"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <!--  CONTACT LIST  -->
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_contacts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="28dp" android:nestedScrollingEnabled="false"/>
        <!--  =========================  -->
        <!--  CODE WORD                -->
        <!--  =========================  -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:text="🔑 Code Word Detection" android:textColor="@color/brand_blue" android:textSize="15sp" android:textStyle="bold"/>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp" app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="14dp" app:cardElevation="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Say your secret word out loud to silently activate all Suraksha agents. Suraksha learns your voice so only you can trigger it." android:textColor="@color/text_secondary" android:textSize="12sp"/>
                <TextView android:id="@+id/tv_code_word_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:text="○ No code word set" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                <Button android:id="@+id/btn_set_code_word" android:layout_width="match_parent" android:layout_height="52dp" android:text="🎤 Set Code Word" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/bg_dark" android:backgroundTint="@color/brand_blue" android:layout_marginBottom="12dp"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_code_word" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enable Code Word Detection" android:textColor="@color/text_primary" android:textSize="14sp"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_voice_verify" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Require my voice to trigger" android:textColor="@color/text_primary" android:textSize="14sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="🔒 When on, only your enrolled voice can trigger the code word (stops false alarms from TV or others). Screaming the code word always works, even without a voice match." android:textColor="@color/text_hint" android:textSize="11sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="💡 Hindi or English both work — try 'Bachao', 'Help me now', or 'Suraksha on'" android:textColor="@color/text_hint" android:textSize="11sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <!--  =========================  -->
        <!--  HEART RATE                -->
        <!--  =========================  -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="♥ Heart Rate Alert Thresholds" android:textColor="@color/brand_blue" android:textSize="15sp" android:textStyle="bold"/>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp" app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="14dp" app:cardElevation="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="14dp">
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:hint="High BPM" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_hr_high" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="3" android:digits="0123456789" android:textColor="@color/text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:hint="Low BPM" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_hr_low" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="3" android:digits="0123456789" android:textColor="@color/text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="💡 High: 100–220 bpm • Low: 30–90 bpm. You'll get a warning when a camera measurement falls outside this range." android:textColor="@color/text_hint" android:textSize="11sp"/>
                <Button android:id="@+id/btn_save_thresholds" android:layout_width="match_parent" android:layout_height="44dp" android:text="Save Thresholds" android:backgroundTint="@color/safe_green" android:textColor="@color/bg_dark" android:textStyle="bold"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <!--  =========================  -->
        <!--  HOME ADDRESS              -->
        <!--  =========================  -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="🏠 Home Address" android:textColor="@color/brand_blue" android:textSize="15sp" android:textStyle="bold"/>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp" app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="14dp" app:cardElevation="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="Save your home address so 'take me home safely' routes you straight home." android:textColor="@color/text_secondary" android:textSize="12sp"/>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:hint="Home address or area" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_home_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPostalAddress" android:textColor="@color/text_primary"/>
                </com.google.android.material.textfield.TextInputLayout>
                <Button android:id="@+id/btn_save_home" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Save Home" android:textAllCaps="false" android:backgroundTint="@color/brand_blue" android:textColor="@color/bg_dark"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <!--  =========================  -->
        <!--  USER GUIDE                -->
        <!--  =========================  -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="📖 User Guide" android:textColor="@color/brand_blue" android:textSize="15sp" android:textStyle="bold"/>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="32dp" app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="14dp" app:cardElevation="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="New to Suraksha AI?" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="Download the complete PDF guide covering all 10 agents, commands, emergency features, and setup steps. Works offline." android:textColor="@color/text_secondary" android:textSize="12sp"/>
                <Button android:id="@+id/btn_download_guide" android:layout_width="match_parent" android:layout_height="52dp" android:text="⬇ Download User Guide (PDF)" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/brand_blue" android:backgroundTint="@color/bg_dark" app:strokeColor="@color/brand_blue" app:strokeWidth="1dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>